<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>OptiGraphMigrator.Tool</RootNamespace>
		<AssemblyName>optigraph-migrate</AssemblyName>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>optigraph-migrate</ToolCommandName>
		<PackageId>OptiGraphMigrator.Tool</PackageId>
		<PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\</PackageOutputPath>
		<Description>Scans a solution for Optimizely Search and Navigation (Find) usage and reports the Optimizely Graph migration path.</Description>
		<RollForward>LatestMajor</RollForward>

		<!-- Recommended for public NuGet.org publishing -->
		<Version>1.1.0</Version>
		<Authors>Graham Carr</Authors>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/adayinthelifeofapro/OptiGraphMigrator</PackageProjectUrl>
		<RepositoryUrl>https://github.com/adayinthelifeofapro/OptiGraphMigrator</RepositoryUrl>
		<PackageTags>optimizely;graph;migration;dotnet-tool</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="OptiGraphMigrator.Tool.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Build.Locator" />
		<PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
		<PackageReference Include="System.CommandLine" />
		<PackageReference Include="System.Drawing.Common" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\OptiGraphMigrator.Core\OptiGraphMigrator.Core.csproj" />
		<ProjectReference Include="..\OptiGraphMigrator.Analyzers\OptiGraphMigrator.Analyzers.csproj" />
		<ProjectReference Include="..\OptiGraphMigrator.Reporting\OptiGraphMigrator.Reporting.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="README.md" Pack="true" PackagePath="\">
		<CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
